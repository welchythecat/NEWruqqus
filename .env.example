# Ruqqus configuration
#
# Copy this file to `.env` and edit it.  Every value here is a placeholder or a
# safe local default -- there are no real secrets in this file, and none belong
# in it.  `.env` is (and must stay) in .gitignore.
#
#   cp .env.example .env
#
# Two variables are REQUIRED and the app will refuse to start without them:
# SECRET_KEY and DATABASE_URL.
#
# If you are using docker compose (the "Quick start with Docker" in
# INSTALL.md) you must also set POSTGRES_PASSWORD -- compose builds the
# DATABASE_URL for you out of the POSTGRES_* values.

# ===========================================================================
# Core secrets
# ===========================================================================

# REQUIRED.  Flask's session-signing key.  Anything signed with this -- the
# login session cookie -- can be forged by anyone who obtains the value, so
# treat it like a password and keep it out of git.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Left deliberately EMPTY here.  A non-empty placeholder would sail through
# both the app's and docker compose's "is it set?" checks, and you would run a
# site whose session cookies anyone can forge with a value printed in this
# repository.  Leaving it blank makes the setup fail loudly instead.
#
# Legacy alias (still accepted): MASTER_KEY
SECRET_KEY=

# Signing key for password-reset and e-mail-verification links.
# Optional.  Defaults to SECRET_KEY so a minimal install works, but use a
# distinct value in production: then leaking one does not compromise the other.
#
# Generate one the same way as SECRET_KEY.
#TOKEN_SIGNING_KEY=change-me-to-another-long-random-string

# ===========================================================================
# Site URL
# ===========================================================================

# Canonical base URL of the site, WITHOUT a trailing slash.  Used to build
# absolute links in e-mails and Atom feeds, and to decide when to redirect
# plain HTTP to HTTPS.
#
# Local development (default if unset):  http://localhost:8000
# Production example:                    https://ruqqus.example.com
#
# Legacy alias (still accepted): domain   -- note the lowercase "d".
SITE_URL=http://localhost:8000

# ===========================================================================
# Database  (REQUIRED)
# ===========================================================================

# PostgreSQL password.
#
# REQUIRED BY DOCKER COMPOSE ONLY (not read by the application).  `docker
# compose` builds DATABASE_URL out of POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB below and hands it to the app container, so this is the value to
# set for the "Quick start with Docker" in INSTALL.md.  Non-Docker installs
# just put a real password in DATABASE_URL and ignore this entirely.
#
# Pick a long random string.  If it contains @ : / ? or # it must be
# percent-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=

# Optional overrides for the docker compose database.  Both default to
# "ruqqus", which matches the local example below.
#POSTGRES_USER=ruqqus
#POSTGRES_DB=ruqqus

# PostgreSQL connection string.
#
# The scheme is normalised automatically: `postgres://` and `postgresql://`
# are both rewritten to SQLAlchemy's psycopg 3 dialect, so you can paste the
# URL your host gives you as-is.
#
# Local example:
DATABASE_URL=postgresql://ruqqus:ruqqus@localhost:5432/ruqqus
#
# With TLS (typical for managed Postgres):
#DATABASE_URL=postgresql://ruqqus:secret@db.example.com:5432/ruqqus?sslmode=require
#
# After setting this, build the schema once with:
#   alembic upgrade head

# ===========================================================================
# Redis
# ===========================================================================

# Used for the response cache and for rate-limit storage.
# Default: redis://localhost:6379/0
#
# Legacy aliases (still accepted): HEROKU_REDIS_PURPLE_URL,
# HEROKU_REDIS_ORANGE_URL.
REDIS_URL=redis://localhost:6379/0

# Force the cache on or off.  Defaults to OFF on localhost and ON everywhere
# else.  When OFF, Flask-Caching uses NullCache (nothing is cached) and rate
# limits are kept in process memory instead of Redis -- fine for development.
#CACHE_ENABLED=true

# ===========================================================================
# E-mail
# ===========================================================================

# "console" (default) prints every message to stdout instead of sending it --
# ideal for development and for verifying the signup/reset flows without an
# SMTP account.  "smtp" sends real mail and requires SMTP_HOST below.
MAIL_BACKEND=console

# From-address for all outgoing mail.
MAIL_FROM=Ruqqus <noreply@example.com>

# --- Only read when MAIL_BACKEND=smtp -------------------------------------
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=ruqqus
#SMTP_PASSWORD=change-me
#SMTP_USE_TLS=true
#SMTP_TIMEOUT=10

# ===========================================================================
# Server behaviour
# ===========================================================================

# How many reverse proxies sit in front of the app.  Currently a boolean in
# practice: true (the default) trusts one layer of X-Forwarded-For /
# -Proto / -Host / -Port / -Prefix, which is what Caddy and Nginx send.
# Set to false when the app is exposed directly and you want the HTTPS
# redirect and client-IP detection disabled.
BEHIND_PROXY=true

# Port used by the development server (`python run_dev.py`).
# Production reads the port from gunicorn's `-b` flag instead.
PORT=8000

# Root logger level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Directory for any future user uploads.  Not used yet -- the original code
# had no upload handling at all.  See MIGRATION_NOTES.md.
#UPLOAD_DIR=/var/lib/ruqqus/uploads

# ===========================================================================
# Variables that NO LONGER EXIST
# ===========================================================================
# These were hardcoded to Ruqqus's own infrastructure and have been removed.
# Setting them now has no effect and is not an error -- they are listed here so
# you know to drop them from an old deployment:
#
#   MAILGUN_KEY        -> replaced by MAIL_BACKEND=smtp + SMTP_* above.
#   reddit_id          -> Reddit integration deleted (routes/reddit_api.py).
#   reddit_secret      -> Reddit integration deleted.
#   MASTER_KEY         -> renamed SECRET_KEY (still accepted as an alias).
#   domain             -> renamed SITE_URL (still accepted as an alias).
